# ====================================================
# BorrowBox Root Environment Template
# ====================================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=borrowbox_dev

# Backend Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=supersecret-borrowbox-production-jwt-key-2026
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# Database Connection (Container networking)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/borrowbox_dev?schema=public

# Redis Configuration (Container networking)
REDIS_URL=redis://redis:6379
REDIS_CACHE_TTL=300
REDIS_ITEM_DETAIL_TTL=600

# Client Configuration
VITE_API_URL=/api
